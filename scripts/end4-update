#!/usr/bin/env bash
# Coloured system update for end-4, in the spirit of HyDE's system.update.py:
# show what is pending, grouped by source, then do it.
#
# Every colour here is a NAMED ansi colour (slots 1-6), never a hex or a 256
# index. Those six are exactly what end-4 repaints from the wallpaper in
# scripts/colors/applycolor.sh, so this follows the theme for free. Hardcoding
# would freeze it -- and if the six look like two, that is the `harmony`
# setting, not this script (see docs/06-troubleshooting.md).
#
# Wired to Config.options.apps.update, so the bar's updates indicator runs it.
set -uo pipefail

if [ -t 1 ]; then
    R=$'\e[0m'; B=$'\e[1m'; DIM=$'\e[2m'
    RED=$'\e[1;31m'; GREEN=$'\e[1;32m'; YELLOW=$'\e[1;33m'
    BLUE=$'\e[1;34m'; MAGENTA=$'\e[1;35m'; CYAN=$'\e[1;36m'
else
    R=""; B=""; DIM=""; RED=""; GREEN=""; YELLOW=""; BLUE=""; MAGENTA=""; CYAN=""
fi

# paru and yay take the same flags for everything used here.
HELPER="${AUR_HELPER:-}"
if [ -z "$HELPER" ]; then
    for h in paru yay; do command -v "$h" >/dev/null && { HELPER="$h"; break; }; done
fi
[ -z "$HELPER" ] && { echo "${RED}No AUR helper found (paru/yay).${R}"; exit 1; }

hold() {
    # The window is spawned by the bar, so it must not vanish with the output.
    echo
    printf '%s' "${DIM}── Press Enter to close ──${R}"
    read -r _
}

printf '%s\n\n' "${B}Checking for updates${R}${DIM}  ($HELPER)${R}"

# checkupdates refreshes a private database copy, so it never leaves the real
# one half-synced -- which is what a bare `pacman -Sy` does, and is how you get
# a partial upgrade. It needs pacman-contrib; without it, fall back to the
# helper, which is slower but correct.
if command -v checkupdates >/dev/null; then
    repo=$(checkupdates 2>/dev/null)
else
    echo "${YELLOW}pacman-contrib is not installed; falling back to $HELPER for the repo list.${R}"
    echo "${DIM}   pacman -S pacman-contrib${R}"
    echo
    repo=$("$HELPER" -Qu --repo 2>/dev/null)
fi
aur=$("$HELPER" -Qua 2>/dev/null)

flat=""
command -v flatpak >/dev/null && flat=$(flatpak remote-ls --updates 2>/dev/null)

count() { [ -z "$1" ] && echo 0 || printf '%s\n' "$1" | wc -l; }
n_repo=$(count "$repo"); n_aur=$(count "$aur"); n_flat=$(count "$flat")
total=$((n_repo + n_aur + n_flat))

row() { # name count colour
    local state
    if [ "$2" -gt 0 ]; then state="${YELLOW}${2} pending${R}"; else state="${GREEN}up to date${R}"; fi
    printf '  %s%-10s%s %s\n' "$3" "$1" "$R" "$state"
}
row "repo"    "$n_repo" "$CYAN"
row "AUR"     "$n_aur"  "$MAGENTA"
[ -n "$(command -v flatpak)" ] && row "flatpak" "$n_flat" "$BLUE"

if [ "$total" -eq 0 ]; then
    printf '\n%s\n' "${GREEN}${B}System is already up to date.${R}"
    hold; exit 0
fi

# name  old -> new, which is the part you actually read before saying yes.
listing() { # colour label body
    [ -z "$3" ] && return
    printf '\n%s%s%s\n' "$1$B" "$2" "$R"
    printf '%s\n' "$3" | while read -r name old arrow new; do
        if [ -n "${new:-}" ]; then
            printf '  %-32s %s%s%s %s->%s %s%s%s\n' \
                "$name" "$DIM" "$old" "$R" "$DIM" "$R" "$GREEN" "$new" "$R"
        else
            printf '  %s\n' "$name $old"
        fi
    done
}
listing "$CYAN"    "Repo ($n_repo)"    "$repo"
listing "$MAGENTA" "AUR ($n_aur)"      "$aur"
listing "$BLUE"    "Flatpak ($n_flat)" "$flat"

printf '\n%s' "${B}Update ${total} package(s)? [Y/n] ${R}"
read -r ans
case "${ans:-y}" in
    [nN]*) printf '\n%s\n' "${YELLOW}Skipped.${R}"; hold; exit 0 ;;
esac

echo
"$HELPER" -Syu
rc=$?

# flatpak is separate: the helper does not touch it.
if [ "$n_flat" -gt 0 ]; then
    printf '\n%s\n' "${B}${BLUE}Flatpak${R}"
    flatpak update
fi

if [ "$rc" -eq 0 ]; then
    printf '\n%s\n' "${GREEN}${B}Done.${R}"
else
    printf '\n%s\n' "${RED}${B}$HELPER exited with $rc.${R}"
fi
hold
